# Stream Firestore to BigQuery — instance: firestore-bigquery-export
# Hand-authored (firebase ext:install --force is interactive-only on this
# CLI version; DE-5 ticket requires config live in git, not the console).
# Param keys verified against extension.yaml @ v0.3.3 (pinned in firebase.json).
# Deploy with: firebase deploy --only extensions --project aitutorproject-197c3

# --- Source: which Firestore collection, which database ---
COLLECTION_PATH=quiz_attempts
DATABASE=(default)
DATABASE_REGION=nam5

# --- Destination: BigQuery dataset/table naming ---
# TRAP F (de.phase3.md): "us" multi-region, matching Firestore's nam5 —
# NOT us-central1 (that's the Cloud Run region, a different concern).
BIGQUERY_PROJECT_ID=aitutorproject-197c3
DATASET_ID=firestore_export
DATASET_LOCATION=us
TABLE_ID=quiz_attempts

# --- Partitioning: TRAP A — immutable after first deploy, must be right now ---
# Partition on the changelog's own `timestamp` column (built-in metadata,
# always present) rather than a Firestore document field, so partitioning
# works uniformly across CREATE/UPDATE/DELETE/IMPORT rows.
TABLE_PARTITIONING=DAY
TIME_PARTITIONING_FIELD=timestamp
TIME_PARTITIONING_FIRESTORE_FIELD=
TIME_PARTITIONING_FIELD_TYPE=omit

# --- Clustering: mutable later, unlike partitioning ---
# document_id, not user_id (de.phase2.md D5 wording nit — see warehouse
# README): `data` is one opaque JSON column, so only top-level changelog
# fields are clusterable. user_id clustering belongs to the DE-6 mart.
CLUSTERING=document_id

# --- View: authored staging view (item 2) is the real contract; this
# extension-generated view is left at the cheap default ---
VIEW_TYPE=view

# --- Everything else: extension defaults, set explicitly for reproducibility ---
WILDCARD_IDS=false
MAX_DISPATCHES_PER_SECOND=100
MAX_ENQUEUE_ATTEMPTS=3
USE_NEW_SNAPSHOT_QUERY_SYNTAX=no
EXCLUDE_OLD_DATA=no
LOG_LEVEL=info

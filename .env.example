# ── Backend ───────────────────────────────────────────────────────────────
# Defaults to false (safe-by-default) when unset. Set true explicitly for
# local dev without Firebase; leave false/unset for any deployed environment.
DEV_MODE=true (development without Firebase) or false (production with Firebase)
DEV_UID=test-user-123

OPEN_AI_EMBEDDINGS_KEY=paste_your_key_here
ANTHROPIC_LUNA_KEY=paste_your_key_here
UNSTRUCTURED_API_KEY=paste_your_key_here
CHUNKING_STRATEGY=fast, auto, hi_res, or character

GOOGLE_APPLICATION_CREDENTIALS=path/to/your/backend/serviceAccountKey.json
FIREBASE_STORAGE_BUCKET=your-firebase-storage-bucket-name

QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=paste_your_key_here

# Cloud Tasks queue (document processing, DE-3). Leave unset locally —
# processing falls back to an in-process thread. Prod sets TASKS_QUEUE
# and the rest default correctly (see infra/setup_queue.sh).
# TASKS_QUEUE=process-document
# TASKS_LOCATION=us-central1
# GCP_PROJECT=aitutorproject-197c3
# TASKS_SERVICE_ACCOUNT=285361659733-compute@developer.gserviceaccount.com
# TASK_HANDLER_BASE_URL=https://ai-tutor-backend-285361659733.us-central1.run.app
# TASKS_MAX_ATTEMPTS=5

# ── Frontend (Vite exposes VITE_ prefix only) ─────────────────────────────
VITE_FIREBASE_API_KEY=your-firebase-api-key
VITE_FIREBASE_AUTH_DOMAIN=your-firebase-auth-domain
VITE_FIREBASE_PROJECT_ID=your-firebase-project-id
VITE_FIREBASE_STORAGE_BUCKET=your-firebase-storage-bucket-name
VITE_FIREBASE_MESSAGING_SENDER_ID=your-firebase-messaging-sender-id
VITE_FIREBASE_APP_ID=your-firebase-app-id
VITE_FIREBASE_MEASUREMENT_ID=your-firebase-measurement-id

FIREBASE_SERVICE_ACCOUNT_JSON=minimized-firebase-account-credentials
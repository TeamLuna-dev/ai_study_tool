#     https://www.atlassian.com/git/tutorials/saving-changes/gitignore

# Node artifact files
node_modules/
dist/
.vite/

# Environment files
.env
.env.local
.env.*.local

# Firebase service account key — never commit
serviceAccountKey.json

# Firebase Hosting cache
.firebase/

# Virtual environment
venv/

/quiz-gen/.env
/backend/.venv
# Compiled Java class files
*.class

# Compiled Python bytecode
*.py[cod]

# Log files
*.log

# Package files
*.jar

# Maven
target/
dist/

# JetBrains IDE
.idea/

# Unit test reports
TEST*.xml

# Generated by MacOS
.DS_Store

# Generated by Windows
Thumbs.db

# Applications
*.app
*.exe
*.war

# Large media files
*.mp4
*.tiff
*.avi
*.flv
*.mov
*.wmv

# Temporary files
temp/

# Implementation briefs — working docs, not project documentation
AUDIO_SIZE_LIMIT_BRIEF.md
AUDIO_UPLOAD_BRIEF.md
GILT_EDGE_REVAMP.md
UX_FIXES_BRIEF.md
domain.initialization.md
qdrant.production.repoint.md
fileupload.increase.md
de.phase2.md
de.phase3.md

.claude